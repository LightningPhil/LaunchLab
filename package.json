{
  "name": "launchlab",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader native",
    "test": "npm run check && node --test tests/*.test.mjs tests/*.test.ts",
    "check": "tsc --noEmit && tsc -p tsconfig.node.json && tsc -p tsconfig.tests.json",
    "build": "npm run check && vite build --configLoader native",
    "preview": "vite preview --configLoader native"
  },
  "engines": { "node": ">=24.0.0" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LightningPhil/LaunchLab.git"
  },
  "keywords": ["physics", "education", "simulation", "ballistics", "rocket", "canvas"],
  "author": "Philip Leichauer",
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "bugs": {
    "url": "https://github.com/LightningPhil/LaunchLab/issues"
  },
  "homepage": "https://github.com/LightningPhil/LaunchLab#readme",
  "description": "Launch Lab: a playful cannon and rocket physics sandbox with recorded, inspectable flights on twelve worlds.",
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/three": "^0.186.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.7"
  },
  "dependencies": {
    "katex": "^0.19.0",
    "three": "^0.186.1"
  }
}
